  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "MIT",
  "devDependencies": {
    "@prelude/cmp": "4.2.0",
    "@swc/core": "1.12.5",
    "@swc/jest": "0.2.38",
    "@tsconfig/node18": "18.2.4",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.3",
    "eslint": "9.29.0",
    "jest": "30.0.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
